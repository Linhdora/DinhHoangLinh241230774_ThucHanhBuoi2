@model Learner
@{ ViewData["Title"] = "Learner Details"; }
<h1>Learner Details</h1><hr />
<dl class="row"><dt class="col-sm-3">Mã</dt><dd class="col-sm-9">@Model.LearnerID</dd><dt class="col-sm-3">Tên</dt><dd class="col-sm-9">@Model.FirstMidName</dd><dt class="col-sm-3">Họ</dt><dd class="col-sm-9">@Model.LastName</dd><dt class="col-sm-3">Ngành</dt><dd class="col-sm-9">@Model.Major.MajorName</dd><dt class="col-sm-3">Ngày nhập học</dt><dd class="col-sm-9">@Model.EnrollmentDate.ToString("g")</dd></dl>
<a asp-action="Edit" asp-route-id="@Model.LearnerID" class="btn btn-primary">Edit</a> <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
