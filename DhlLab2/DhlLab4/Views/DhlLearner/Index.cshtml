@model IEnumerable<DhlLab4.Models.DhlLearner>
@{
    ViewData["Title"] = "Learner List";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Learner List</h1>
    <a asp-action="Create" class="btn btn-primary">Create New Learner</a>
</div>

@if (TempData["DeleteError"] is string deleteError)
{
    <div class="alert alert-warning" role="alert">@deleteError</div>
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Tên</th>
                <th>Họ</th>
                <th>Ngành</th>
                <th>Ngày nhập học</th>
                <th>Chức năng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var learner in Model)
            {
                <tr>
                    <td>@learner.LearnerID</td>
                    <td>@learner.FirstMidName</td>
                    <td>@learner.LastName</td>
                    <td>@learner.Major?.MajorName</td>
                    <td>@learner.EnrollmentDate.ToString("d")</td>
                    <td class="text-nowrap">
                        <a asp-action="Edit" asp-route-id="@learner.LearnerID">Edit</a>
                        <span aria-hidden="true"> | </span>
                        <a asp-action="Delete" asp-route-id="@learner.LearnerID">Delete</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-secondary">Chưa có người học nào.</td></tr>
            }
        </tbody>
    </table>
</div>
