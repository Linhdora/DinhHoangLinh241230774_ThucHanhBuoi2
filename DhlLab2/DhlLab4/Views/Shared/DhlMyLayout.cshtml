<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DhlLab4</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/DhlLayout.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="dhl-app">
    @await Html.PartialAsync("DhlTopNav")
    <div class="dhl-shell">
        @await Html.PartialAsync("DhlLeftMenu")
        <div class="dhl-main-column">
            <main class="dhl-content" role="main">
                @RenderBody()
            </main>
            <footer class="dhl-footer">
                @await Html.PartialAsync("DhlFooter")
            </footer>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/DhlLayout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
